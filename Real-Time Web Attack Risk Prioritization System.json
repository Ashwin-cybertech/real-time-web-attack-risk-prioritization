    {
      "parameters": {
        "jsCode": "const attack = ($json.attack_type || \"\").toLowerCase();\n\nlet owasp = \"Unknown\";\nlet risk_score = 30;\nlet risk_level = \"LOW\";\nlet decision = \"LOG\";\n\nif (attack.includes(\"sql\")) {\n  owasp = \"A03: Injection\";\n  risk_score = 90;\n  risk_level = \"HIGH\";\n  decision = \"ESCALATE\";\n} \nelse if (attack.includes(\"xss\")) {\n  owasp = \"A07: XSS\";\n  risk_score = 70;\n  risk_level = \"MEDIUM\";\n  decision = \"REVIEW\";\n}\nelse if (attack.includes(\"path\")) {\n  owasp = \"A01: Broken Access Control\";\n  risk_score = 80;\n  risk_level = \"HIGH\";\n  decision = \"ESCALATE\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    owasp_category: owasp,\n    risk_score,\n    risk_level,\n    decision,\n    ai_explanation: `Detected ${attack} attack`\n  }\n}];\n"
      },
